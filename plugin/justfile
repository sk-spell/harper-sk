default:
  @just --list

wasm := "target/wasm32-unknown-unknown/release/harper_sk.wasm"

# Format all Rust code.
format:
  cargo fmt --all

# What CI checks first.
check:
  cargo fmt --all -- --check
  cargo clippy --all-targets -- -D warnings

# The native tests (spell check, suggestions, language detection).
test:
  cargo test --lib

# Expand the word list into pack/slovak.pack, which build.rs bakes in (else it is expanded at first use).
bake-pack:
  cargo run --release --example bake_pack

# Build the plugin. Needs the wasm32-unknown-unknown target.
build-wasm: bake-pack
  cargo build --release --target wasm32-unknown-unknown
  @ls -l {{wasm}}

# Load the built module through harper-plugin-host and lint with it.
test-plugin: build-wasm
  cargo test --release --test plugin_host -- --nocapture --test-threads=1

# Produce dist/harper-sk.wasm and its checksum. VERSION like 0.1.0.
release-files VERSION: build-wasm
  #!/usr/bin/env bash
  set -euo pipefail
  mkdir -p dist
  if command -v wasm-opt >/dev/null; then
    wasm-opt -Oz --enable-bulk-memory --enable-sign-ext --enable-nontrapping-float-to-int \
      -o dist/harper-sk.wasm {{wasm}}
  else
    echo "wasm-opt not found; shipping the unoptimized module" >&2
    cp {{wasm}} dist/harper-sk.wasm
  fi
  (cd dist && sha256sum harper-sk.wasm > harper-sk.wasm.sha256)
  ls -l dist
